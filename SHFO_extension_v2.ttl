shf:Carbohydrate rdf:type owl:Class ;
                 rdfs:subClassOf shf:MacroNutrient .


###  http://SustainHealthyFoodOntology#CarbohydratesMolecules
shf:CarbohydratesMolecules rdf:type owl:Class ;
                           rdfs:subClassOf shf:Macromolecules .


###  http://SustainHealthyFoodOntology#ChemicalMessengers
shf:ChemicalMessengers rdf:type owl:Class ;
                       rdfs:subClassOf gufo:Quantity .


###  http://SustainHealthyFoodOntology#Chicken
shf:Chicken rdf:type owl:Class ;
            rdfs:subClassOf shf:Meat .


###  http://SustainHealthyFoodOntology#Child
shf:Child rdf:type owl:Class ;
          rdfs:subClassOf shf:Person .


###  http://SustainHealthyFoodOntology#Consumer
shf:Consumer rdf:type owl:Class ;
             rdfs:subClassOf shf:Person .


###  http://SustainHealthyFoodOntology#Context
shf:Context rdf:type owl:Class ;
            rdfs:subClassOf gufo:Situation ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty [ owl:inverseOf gufo:inheresIn
                                             ] ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass shf:ContextualFactor
                            ] .


###  http://SustainHealthyFoodOntology#ContextualExplanation
shf:ContextualExplanation rdf:type owl:Class ;
                          rdfs:subClassOf shf:ExplanationComponent .


###  http://SustainHealthyFoodOntology#ContextualFactor
shf:ContextualFactor rdf:type owl:Class ;
                     rdfs:subClassOf gufo:IntrinsicMode ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:inheresIn ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass shf:Behavior
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:inheresIn ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass shf:Context
                                     ] .


###  http://SustainHealthyFoodOntology#Corticosteroids
shf:Corticosteroids rdf:type owl:Class ;
                    rdfs:subClassOf shf:Steroids ;
                    rdf:label "Corticosteroids" ;
                    rdfs:comment "Steroid hormones produced by the adrenal glands, or medicines designed to imitate them. They help regulate inflammation, immune responses, metabolism, and stress." .


###  http://SustainHealthyFoodOntology#Crop
shf:Crop rdf:type owl:Class ;
         rdfs:subClassOf gufo:FunctionalComplex ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty gufo:mediates ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass shf:ProductionScores
                         ] .


