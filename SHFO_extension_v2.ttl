                   rdfs:subClassOf shf:OtherFood .


###  http://SustainHealthyFoodOntology#Obesity
shf:Obesity rdf:type owl:Class ;
            rdfs:subClassOf shf:WeightState ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty gufo:inheresIn ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass shf:BodyMassIndex
                            ] .


###  http://SustainHealthyFoodOntology#OccassionEnum
shf:OccassionEnum rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( shf:AfternoonSnack
                                                    shf:Breakfast
                                                    shf:Dinner
                                                    shf:EveningSnack
                                                    shf:Lunch
                                                    shf:MorningSnack
                                                  )
                                      ] ;
                  rdfs:subClassOf gufo:QualityValue .


