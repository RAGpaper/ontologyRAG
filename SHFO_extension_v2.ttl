shf:AmountOfWaterUse rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf gufo:hasQualityValue ;
                     rdfs:domain shf:WaterUse ;
                     rdfs:label "AmountOfWaterUse"@en .


