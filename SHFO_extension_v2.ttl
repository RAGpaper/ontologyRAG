                     shf:Hormone ;
            shf:hasEffectOn "Managing blood sugar/energy, produced by the pancreas" ,
                            "converting glucose (sugar) in the consumed food into a form the body can use for energy" ;
            rdf:label "Insulin" ;
            rdfs:comment "A hormone produced by the pancreas that helps glucose move from the blood into cells, where it is used for energy. It is essential for controlling blood-glucose levels." .


