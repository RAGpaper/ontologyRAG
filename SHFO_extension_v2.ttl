shf:KetoDiet rdfs:comment "The ketogenic (keto) diet is a very low-carb, high-fat eating plan designed to force your body into ketosis—a metabolic state where it burns fat for energy instead of glucose. It typically restricts carbohydrate intake to under 50 grams per day while deriving roughly 70% to 80% of your calories from fats." ;
             rdfs:label "KetoDiet" .


shf:LactoseRestrictedDiet rdfs:comment "Limits or avoids lactose, the natural sugar in milk and many dairy products. It is commonly used for lactose intolerance." ;
                          rdfs:label "LactoseRestrictedDiet"@en .


shf:Lamb rdfs:label "Lamb"@en .


shf:LandUse rdfs:label "LandUse"@en .


shf:Legumes rdfs:label "Legumes"@en .


shf:LightDigestibleDiet rdfs:comment "A diet of mild, easy-to-digest foods that place less stress on the stomach and intestines. It usually avoids fried, fatty, very spicy, and highly processed foods." ;
                        rdfs:label "LightDigestibleDiet"@en .


shf:Lipids rdfs:comment "A broad group of substances that includes fats, oils, phospholipids, waxes, and steroids. They help store energy, form cell membranes, insulate the body, and produce signaling molecules." ;
           rdfs:label "Lipids"@en .


shf:Lunch rdf:label "Lunch" .


shf:MacroNutrient rdfs:comment "A macronutrient is a nutrient the body needs in relatively large amounts for energy, growth, repair, and normal functioning." ;
                  rdfs:label "MacroNutrient"@en .


shf:Macromolecules rdfs:comment "Macromolecules are large biological molecules that form cells, store energy, and support body functions. The four main groups are carbohydrates, lipids, nucleic acids, and proteins." ;
                   rdfs:label "Macromolecules"@en .


