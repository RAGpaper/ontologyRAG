shf:ContainsTracesOf_1 rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf gufo:hasQualityValue ;
                       rdfs:domain shf:Recipe ;
                       rdfs:label "ContainsTracesOf"@en .


