shf:AmountOfZincNeededPerDay rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf gufo:hasQualityValue ;
                             rdfs:domain shf:DailyIntakeLevel ;
                             rdfs:label "AmountOfZincNeededPerDay"@en .


