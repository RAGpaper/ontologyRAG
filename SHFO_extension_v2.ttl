###  http://SustainHealthyFoodOntology#Pedriatic
shf:Pedriatic rdf:type owl:Class ;
              rdfs:subClassOf shf:LifeStage ;
              rdf:label "Pedriatic" ;
              rdfs:comment "A person below the legal or clinical age of adulthood. Nutritional needs vary by age and growth stage." .


###  http://SustainHealthyFoodOntology#Person
shf:Person rdf:type owl:Class ;
           rdfs:subClassOf gufo:FunctionalComplex ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:mediates ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass shf:Follows
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:mediates ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass shf:FoodConsumption
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:mediates ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass shf:NutrientNeeds
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty [ owl:inverseOf gufo:inheresIn
                                            ] ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass shf:HealthState
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty [ owl:inverseOf gufo:inheresIn
                                            ] ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass shf:HumanFunctions
                           ] .


