shf:Omega3 rdf:type owl:NamedIndividual ,
                    shf:FattyAcids ;
           shf:hasFoodSource shf:Fish ,
                             shf:food_anchovy_in_oil_canned ,
                             shf:food_anchovy_raw ,
                             shf:food_chia_seeds_dried ,
                             shf:food_hemp_seed ,
                             shf:food_herring_raw ,
                             shf:food_herring_salted ,
                             shf:food_linseeds ,
                             shf:food_mackerel_raw ,
                             shf:food_oil_rapeseed ,
                             shf:food_salmon_farmed_raw ,
                             shf:food_salmon_smoked ,
                             shf:food_sardines_pilchards_in_oil_tinned ,
                             shf:food_walnuts_salted ,
                             shf:food_walnuts_unsalted ,
                             shf:recipe_349 ;
           shf:hasPositiveEffectOn shf:Anxious ,
                                   shf:Depressed ,
                                   shf:LowMood ,
                                   shf:Stressed ;
           rdfs:comment "A family of polyunsaturated fats needed for normal cell function, brain health, and cardiovascular health. The richest sources are oily fish (salmon, mackerel, sardines, herring); plant-based sources suitable for vegan and vegetarian diets include flaxseed/linseed, chia seeds, walnuts, hemp seeds and rapeseed (canola) oil." ;
           rdfs:label "Omega-3"@en .


