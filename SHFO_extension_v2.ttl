#################################################################
#    Classes
#################################################################

###  http://SustainHealthyFoodOntology#Adult
shf:Adult rdf:type owl:Class ;
          rdfs:subClassOf shf:Person .


###  http://SustainHealthyFoodOntology#AlcoholicBeverages
shf:AlcoholicBeverages rdf:type owl:Class ;
                       rdfs:subClassOf shf:Beverages .


###  http://SustainHealthyFoodOntology#AminoAcids
shf:AminoAcids rdf:type owl:Class ;
               rdfs:subClassOf shf:Micromolecules .


###  http://SustainHealthyFoodOntology#Anabolic
shf:Anabolic rdf:type owl:Class ;
             rdfs:subClassOf shf:Steroids ;
             rdf:label "Anabolic" ;
             rdfs:comment "Synthetic substances related to testosterone that promote protein production and the growth of muscle and other tissues. They may be prescribed medically but can cause serious harm when misused." .


###  http://SustainHealthyFoodOntology#Anemia
shf:Anemia rdf:type owl:Class ;
           rdfs:subClassOf shf:HealthState .


###  http://SustainHealthyFoodOntology#AntiInflammatoryCompound
shf:AntiInflammatoryCompound rdf:type owl:Class ;
                             rdfs:subClassOf shf:FunctionalMolecules .


###  http://SustainHealthyFoodOntology#Antioxidant
shf:Antioxidant rdf:type owl:Class ;
                rdfs:subClassOf shf:FunctionalMolecules .


###  http://SustainHealthyFoodOntology#Appetite
shf:Appetite rdf:type owl:Class ;
             rdfs:subClassOf shf:PsychopsysiologicalFunctions .


###  http://SustainHealthyFoodOntology#AppetiteState
shf:AppetiteState rdf:type owl:Class ;
                  rdfs:subClassOf shf:TimeSensitiveState .


###  http://SustainHealthyFoodOntology#Athlete
shf:Athlete rdf:type owl:Class ;
            rdfs:subClassOf shf:Person .


###  http://SustainHealthyFoodOntology#Bacterium
shf:Bacterium rdf:type owl:Class ;
              rdfs:subClassOf shf:Microorganism .


###  http://SustainHealthyFoodOntology#Beef
shf:Beef rdf:type owl:Class ;
         rdfs:subClassOf shf:Meat .


###  http://SustainHealthyFoodOntology#Behavior
shf:Behavior rdf:type owl:Class ;
             rdfs:subClassOf gufo:Relator ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:mediates ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass shf:Brain
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:mediates ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass shf:NeurobehavioralFunctions
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:mediates ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass shf:Person
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:inheresIn
                                              ] ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass shf:ContextualFactor
                             ] .


###  http://SustainHealthyFoodOntology#Beverages
shf:Beverages rdf:type owl:Class ;
              rdfs:subClassOf shf:FoodGroup .


###  http://SustainHealthyFoodOntology#BloodPressureLevel
shf:BloodPressureLevel rdf:type owl:Class ;
                       rdfs:subClassOf gufo:Quality ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty gufo:mediates ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass shf:BloodPressureMeasurement
                                       ] .


###  http://SustainHealthyFoodOntology#BloodPressureMeasurement
shf:BloodPressureMeasurement rdf:type owl:Class ;
                             rdfs:subClassOf gufo:Relator ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty gufo:mediates ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass shf:Hypertension
                                             ] .


###  http://SustainHealthyFoodOntology#BloodSugarLevel
shf:BloodSugarLevel rdf:type owl:Class ;
                    rdfs:subClassOf gufo:Quality .


###  http://SustainHealthyFoodOntology#BodyMassIndex
shf:BodyMassIndex rdf:type owl:Class ;
                  rdfs:subClassOf gufo:Quality ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gufo:inheresIn ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass shf:NormalWeight
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                   ] ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass shf:Obesity
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                   ] ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass shf:Overweight
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                   ] ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass shf:Underweight
                                  ] .


###  http://SustainHealthyFoodOntology#Brain
shf:Brain rdf:type owl:Class ;
          rdfs:subClassOf gufo:FunctionalComplex .


###  http://SustainHealthyFoodOntology#Bread
shf:Bread rdf:type owl:Class ;
          rdfs:subClassOf shf:OtherFood .


###  http://SustainHealthyFoodOntology#Breakfast
shf:Breakfast rdf:type owl:Class ;
              rdfs:subClassOf shf:Meal .


###  http://SustainHealthyFoodOntology#Candy
shf:Candy rdf:type owl:Class ;
          rdfs:subClassOf shf:OtherFood .


