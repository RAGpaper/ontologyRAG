@prefix : <http://SustainHealthyFoodOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix shf: <http://SustainHealthyFoodOntology#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://SustainHealthyFoodOntology#> .

<http://SustainHealthyFoodOntology/2.0.0> rdf:type owl:Ontology ;
                                           <http://purl.org/dc/elements/1.1/description> "2026-06-01"^^xsd:dateTime ,
                                                                                         "SustainHealthyFood ontology establishes a semantic connection between the sustainability, health and food domains, supporting individuals in making informed nutritional decisions and receiving personalized recommendations based on dietary needs and personal preferences" ,
                                                                                         "anonymous" ;
                                           <http://purl.org/dc/elements/1.1/title> "SustainHealthyFoodOntology extension" ;
                                           <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/" ;
                                           <http://purl.org/dc/terms/source> "NEVO online, version 2023/8.0. RIVM, Bilthoven." ;
                                           rdfs:comment "The nutritional composition data included in this ontology originate from the Dutch Food Composition Database (NEVO), version 2023/8.0, maintained by the National Institute for Public Health and the Environment (RIVM), the Netherlands.Source: NEVO online, version 2023/8.0. RIVM, Bilthoven.Reference: Rijksinstituut voor Volksgezondheid en Milieu (RIVM). (2023). NEVO online, version 2023/8.0. RIVM, Bilthoven. https://www.rivm.nl/en/dutch-food-composition-database" ;
                                           owl:priorVersion "https://agroportal.eu/ontologies/SHFO" ;
                                           owl:versionInfo "2.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://SustainHealthyFoodOntology#recommendedFor
shf:recommendedFor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#label
rdf:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://SustainHealthyFoodOntology#ContainsTracesOf
shf:ContainsTracesOf rdf:type owl:ObjectProperty ;
                     rdfs:domain shf:Food .


###  http://SustainHealthyFoodOntology#IsFortifiedWith
shf:IsFortifiedWith rdf:type owl:ObjectProperty ;
                    rdfs:domain shf:Recipe .


###  http://SustainHealthyFoodOntology#RecommendedFor
shf:RecommendedFor rdf:type owl:ObjectProperty ;
                   rdfs:domain shf:Food ;
                   rdfs:range shf:Diet ,
                              shf:HealthState ,
                              shf:LifeStage ,
                              gufo:Situation .


###  http://SustainHealthyFoodOntology#Reduces
shf:Reduces rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf shf:hasNutrientEffect ;
            rdfs:domain shf:Nutrient ;
            rdfs:range shf:HealthState ,
                       shf:HumanFunctions .


###  http://SustainHealthyFoodOntology#Regulates
shf:Regulates rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf shf:hasNutrientEffect ;
              rdfs:domain shf:Nutrient ;
              rdfs:range shf:HealthState ,
                         shf:HumanFunctions .


###  http://SustainHealthyFoodOntology#RestrictedFood
shf:RestrictedFood rdf:type owl:ObjectProperty ;
                   rdfs:domain shf:Food ,
                               shf:Recipe ;
                   rdfs:range shf:Diet ,
                              shf:HealthState ,
                              gufo:Situation ;
                   rdfs:label "RestrictedFood" .


###  http://SustainHealthyFoodOntology#Stimulates
shf:Stimulates rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf shf:hasNutrientEffect ;
               rdfs:domain shf:Nutrient ;
               rdfs:range shf:HealthState ,
                          shf:HumanFunctions .


###  http://SustainHealthyFoodOntology#Supports
shf:Supports rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf shf:hasNutrientEffect ;
             rdfs:domain shf:Nutrient ;
             rdfs:range shf:HealthState ,
                        shf:HumanFunctions .


###  http://SustainHealthyFoodOntology#belongsToFoodGroup
shf:belongsToFoodGroup rdf:type owl:ObjectProperty ;
                       rdfs:domain shf:Food .


###  http://SustainHealthyFoodOntology#chemicalMessengersHasPerson
shf:chemicalMessengersHasPerson rdf:type owl:ObjectProperty ;
                                rdfs:domain shf:ChemicalMessengers ;
                                rdfs:range shf:Person .


###  http://SustainHealthyFoodOntology#containsMolecule
shf:containsMolecule rdf:type owl:ObjectProperty .


###  http://SustainHealthyFoodOntology#foodGroupHasFood
shf:foodGroupHasFood rdf:type owl:ObjectProperty ;
                     rdfs:domain shf:FoodGroup ;
                     rdfs:range shf:Food .


###  http://SustainHealthyFoodOntology#foodHasNutrient
shf:foodHasNutrient rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain shf:Food ;
                    rdfs:range shf:Nutrient .


###  http://SustainHealthyFoodOntology#forRecipe
shf:forRecipe rdf:type owl:ObjectProperty .


###  http://SustainHealthyFoodOntology#hasFoodSource
shf:hasFoodSource rdf:type owl:ObjectProperty ;
                  rdfs:domain shf:Molecules .


###  http://SustainHealthyFoodOntology#hasIngredient
shf:hasIngredient rdf:type owl:ObjectProperty ;
                  rdfs:domain shf:Recipe .


###  http://SustainHealthyFoodOntology#hasNutrientEffect
shf:hasNutrientEffect rdf:type owl:ObjectProperty ;
                      rdfs:domain shf:Nutrient ;
                      rdfs:range shf:HealthState ,
                                 shf:HumanFunctions ,
                                 shf:TimeSensitiveState .


###  http://SustainHealthyFoodOntology#hasPositiveEffectOn
shf:hasPositiveEffectOn rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf shf:hasNutrientEffect .


###  http://SustainHealthyFoodOntology#highlyRecommendedFor
shf:highlyRecommendedFor rdf:type owl:ObjectProperty ;
                         rdfs:domain shf:Food ,
                                     shf:Recipe ;
                         rdfs:range shf:Diet ,
                                    shf:HealthState ,
                                    gufo:Situation ;
                         rdfs:label "HighlyRecommendedFor" .


###  http://SustainHealthyFoodOntology#inhibits
shf:inhibits rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf shf:hasNutrientEffect ;
             rdfs:domain shf:Nutrient ;
             rdfs:range shf:HealthState ,
                        shf:HumanFunctions .


###  http://SustainHealthyFoodOntology#isIdealFor
shf:isIdealFor rdf:type owl:ObjectProperty ;
               rdfs:domain shf:Food ,
                           shf:Recipe ;
               rdfs:range shf:Meal .


###  http://SustainHealthyFoodOntology#notRecommendedFor
shf:notRecommendedFor rdf:type owl:ObjectProperty ;
                      rdfs:domain shf:Food ;
                      rdfs:range shf:Diet ,
                                 shf:HealthState ,
                                 gufo:Situation .


###  http://SustainHealthyFoodOntology#occassionEnumHasOccassionOfConsumption
shf:occassionEnumHasOccassionOfConsumption rdf:type owl:ObjectProperty ;
                                           rdfs:domain shf:OccassionEnum ;
                                           rdfs:range shf:OccassionOfConsumption .


###  http://SustainHealthyFoodOntology#proteinMoleculesHasAminoAcids
shf:proteinMoleculesHasAminoAcids rdf:type owl:ObjectProperty ;
                                  rdfs:domain shf:ProteinMolecules ;
                                  rdfs:range shf:AminoAcids .


###  http://SustainHealthyFoodOntology#recipeHasIngredient
shf:recipeHasIngredient rdf:type owl:ObjectProperty ;
                        rdfs:domain shf:Recipe ;
                        rdfs:range shf:Ingredient .


###  http://SustainHealthyFoodOntology#recommendationHasExplanationComponent
shf:recommendationHasExplanationComponent rdf:type owl:ObjectProperty ;
                                          rdfs:domain shf:Recommendation ;
                                          rdfs:range shf:ExplanationComponent .


###  http://SustainHealthyFoodOntology#recommendationHasRecipe
shf:recommendationHasRecipe rdf:type owl:ObjectProperty ;
                            rdfs:domain shf:Recommendation ;
                            rdfs:range shf:Recipe .


###  http://SustainHealthyFoodOntology#recommendedTofollow
shf:recommendedTofollow rdf:type owl:ObjectProperty ;
                        rdfs:domain shf:HealthState ;
                        rdfs:range shf:Diet .


###  http://SustainHealthyFoodOntology#timeSensitiveStateHasHealthStateEffect
shf:timeSensitiveStateHasHealthStateEffect rdf:type owl:ObjectProperty ;
                                           rdfs:domain shf:TimeSensitiveState ;
                                           rdfs:range shf:HealthStateEffect .


###  http://SustainHealthyFoodOntology#timeSensitiveStateHasPerson
shf:timeSensitiveStateHasPerson rdf:type owl:ObjectProperty ;
                                rdfs:domain shf:TimeSensitiveState ;
                                rdfs:range shf:Person .


###  http://purl.org/nemo/gufo#inheresIn
gufo:inheresIn rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#mediates
gufo:mediates rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://SustainHealthyFoodOntology#AmountOfCO2emissions
shf:AmountOfCO2emissions rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf gufo:hasQualityValue ;
                         rdfs:domain shf:GreenhouseGasEmmisions ;
                         rdfs:label "AmountOfCO2emissions"@en .


###  http://SustainHealthyFoodOntology#AmountOfCalcium
shf:AmountOfCalcium rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf gufo:hasQualityValue ;
                    rdfs:label "AmountOfCalcium"@en .


###  http://SustainHealthyFoodOntology#AmountOfCalciumNeededPerDay
shf:AmountOfCalciumNeededPerDay rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf gufo:hasQualityValue ;
                                rdfs:domain shf:DailyIntakeLevel ;
                                rdfs:label "AmountOfCalciumNeededPerDay"@en .


###  http://SustainHealthyFoodOntology#AmountOfCaloriesNeededPerDay
shf:AmountOfCaloriesNeededPerDay rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf gufo:hasQualityValue ;
                                 rdfs:domain shf:DailyIntakeLevel ;
                                 rdfs:label "AmountOfCaloriesNeededPerDay"@en .


###  http://SustainHealthyFoodOntology#AmountOfCaloriesPerRecipe
shf:AmountOfCaloriesPerRecipe rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf gufo:hasQualityValue ;
                              rdfs:domain shf:FoodConsumption ;
                              rdfs:label "AmountOfCaloriesPerRecipe"@en .


###  http://SustainHealthyFoodOntology#AmountOfCarbs
shf:AmountOfCarbs rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf gufo:hasQualityValue ;
                  rdfs:domain shf:Carbohydrate ;
                  rdfs:label "AmountOfCarbs"@en .


###  http://SustainHealthyFoodOntology#AmountOfCarbsNeededPerDay
shf:AmountOfCarbsNeededPerDay rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf gufo:hasQualityValue ;
                              rdfs:domain shf:DailyIntakeLevel ;
                              rdfs:label "AmountOfCarbsNeededPerDay"@en .


###  http://SustainHealthyFoodOntology#AmountOfEnergyUse
shf:AmountOfEnergyUse rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf gufo:hasQualityValue ;
                      rdfs:domain shf:EnergyUse ;
                      rdfs:label "AmountOfEnergyUse"@en .


###  http://SustainHealthyFoodOntology#AmountOfEutrophication
shf:AmountOfEutrophication rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf gufo:hasQualityValue ;
                           rdfs:domain shf:Eutrophication ;
                           rdfs:label "AmountOfEutrophication"@en .


###  http://SustainHealthyFoodOntology#AmountOfFat
shf:AmountOfFat rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf gufo:hasQualityValue ;
                rdfs:domain shf:Fat ;
                rdfs:label "AmountOfFat"@en .


