                                    ] .


###  http://SustainHealthyFoodOntology#Producer
shf:Producer rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:mediates
                                              ] ;
                               owl:someValuesFrom shf:ProductionScores
                             ] .


