shf:Nutrient rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:mediates ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass shf:Includes
                             ] .


###  http://SustainHealthyFoodOntology#NutrientEffect
shf:NutrientEffect rdf:type owl:Class ;
                   rdfs:subClassOf gufo:Relator ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:mediates ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass shf:Nutrient
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:mediates ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass shf:PsychopsysiologicalFunctions
                                   ] .


###  http://SustainHealthyFoodOntology#NutrientNeeds
shf:NutrientNeeds rdf:type owl:Class ;
                  rdfs:subClassOf gufo:Relator ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gufo:mediates ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass shf:DailyIntakeLevel
                                  ] .


