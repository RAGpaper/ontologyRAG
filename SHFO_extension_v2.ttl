###  http://SustainHealthyFoodOntology#Food
shf:Food rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( gufo:FunctionalComplex
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty gufo:inheresIn ;
                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass shf:ProcessingLevel
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty gufo:mediates ;
                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass shf:EcoScore
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] .


